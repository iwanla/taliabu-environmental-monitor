{
	"name": "taliabu-environmental-dev",
	"main": "worker/index.ts",
	"compatibility_date": "2024-12-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vars": {
		"ENVIRONMENT": "development",
		"API_HOST": "localhost"
	},
	"assets": {
		"directory": "dist",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "taliabu-db",
			"database_id": "77fe3a7f-a516-40f3-ac5e-a7115c02cbef"
		}
	]
}
