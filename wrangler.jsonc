{
  "name": "taliabu-environmental",
  "main": "worker/index.ts",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "taliabu-db",
      "database_id": "placeholder-replace-with-real-d1-id"
    }
  ]
}
