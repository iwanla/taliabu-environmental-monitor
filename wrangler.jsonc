{
	"name": "taliabu-environmental",
	"main": "worker/index.ts",
	"compatibility_date": "2024-12-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true,
			"head_sampling_rate": 0.01
		}
	},
	"assets": {
		"directory": "dist",
		"binding": "ASSETS"
	},
	"routes": [
		{
			"pattern": "environment.jelajahtaliabu.web.id",
			"custom_domain": true
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "taliabu-db",
			"database_id": "77fe3a7f-a516-40f3-ac5e-a7115c02cbef",
			"remote": true
		}
	]
}