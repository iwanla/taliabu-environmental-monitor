# Static asset caching (Phase 19).
# Reference datasets are regenerated by scripts, so cache for a day and allow
# stale serving while revalidating; Vite output filenames are content-hashed.

/data/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.png
  Cache-Control: public, max-age=604800

/favicon.svg
  Cache-Control: public, max-age=604800